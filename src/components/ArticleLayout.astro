---
import Base from '../layouts/Base.astro';
import type { Article } from '../data/articles';

interface Props {
  article: Article;
  /** Long form of the date, e.g. "12. September 2026". */
  longDate?: string;
}

const { article, longDate = article.date } = Astro.props;
---
<Base title={article.title} description={article.teaser} current="artikel">
  <main class="container page-main">
    <a href="/artikel/" class="back">← Alle Artikel</a>
    <article class="article">
      <div class="meta">
        <span class="tag tag-accent">{article.tag}</span>
        <span class="text-muted">{article.author} · {longDate} · {article.min} Min. Lesezeit</span>
      </div>
      <h1>{article.title}</h1>
      <slot />
    </article>

    <section class="more">
      <h6 class="kicker">Weiterlesen</h6>
      <div class="more-grid">
        <slot name="more" />
      </div>
    </section>
  </main>
</Base>

<style>
  .back { font-size: 14px; text-decoration: none; }
  .article { max-width: 720px; margin-top: 20px; }
  .meta { display: flex; gap: 10px; align-items: center; margin-bottom: 15px; flex-wrap: wrap; font-size: 13px; }
  .article h1 { font-size: clamp(34px, 6.8vw, 52px); margin-bottom: 20px; text-wrap: balance; }
  .article :global(.lead) { font-size: 21px; line-height: 1.45; font-style: italic; margin-bottom: 40px; }
  .more { margin-top: 80px; max-width: 820px; }
  .more-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 30px; }
</style>
