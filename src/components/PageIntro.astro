---
// Kicker, headline and lead paragraph at the top of every section page.
interface Props {
  kicker: string;
  title: string;
  /** Lead text; use the default slot instead when it needs markup (links). */
  lead?: string;
  /** "page" for section overviews, "large" for the Über page's longer lead. */
  size?: 'page' | 'large';
}

const { kicker, title, lead, size = 'page' } = Astro.props;
---
<div class:list={['intro', size]}>
  <h6 class="kicker">{kicker}</h6>
  <h1>{title}</h1>
  {(lead || Astro.slots.has('default')) && <p>{lead}<slot /></p>}
</div>

<style>
  .intro { max-width: 720px; }
  h6 { margin-bottom: 10px; }
  h1 { font-size: clamp(34px, 6.25vw, 48px); margin-bottom: 15px; text-wrap: balance; }
  p { font-size: 18px; line-height: 1.5; max-width: 600px; }
  .large h1 { margin-bottom: 20px; }
  .large p { font-size: 19px; line-height: 1.55; max-width: none; }
</style>
