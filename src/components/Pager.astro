---
// Previous/next links at the end of a chapter or tutorial. A missing side renders disabled.
interface Props {
  prev?: string;
  next?: string;
  prevLabel: string;
  nextLabel: string;
}

const { prev, next, prevLabel, nextLabel } = Astro.props;
---
<div class="pager">
  {prev ? <a class="btn btn-ghost" href={prev}>← {prevLabel}</a> : <span class="btn btn-ghost" aria-disabled="true">← {prevLabel}</span>}
  {next ? <a class="btn btn-ghost" href={next}>{nextLabel} →</a> : <span class="btn btn-ghost" aria-disabled="true">{nextLabel} →</span>}
</div>

<style>
  .pager { display: flex; justify-content: space-between; gap: 20px; margin-top: 50px; flex-wrap: wrap; }
  [aria-disabled='true'] { opacity: .45; pointer-events: none; }
</style>
