---
import '../styles/broadsheet.css';
import '../styles/site.css';
import Header, { type NavKey } from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  current?: NavKey;
  headerSearch?: boolean;
}

const {
  title,
  description = 'Der ECMAScript-Standard auf Deutsch – übersetzt, kommentiert, mit Beispielen zum direkt Ausführen. Dazu Artikel, Tutorials und ein Blog.',
  current,
  headerSearch = false,
} = Astro.props;
const fullTitle = title ? `${title} · EcmaScript.de` : 'EcmaScript.de – JavaScript, wie es im Standard steht';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"
    />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        document.documentElement.dataset.theme = localStorage.getItem('esde-theme') || 'light';
      } catch (e) {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <Header current={current} search={headerSearch} />
    <slot />
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
