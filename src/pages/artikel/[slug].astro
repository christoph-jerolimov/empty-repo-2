---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import RelatedCard from '../../components/RelatedCard.astro';
import { chapterHref, dateLong, DEFAULT_EDITION, getArticles, getAuthor, getRelated } from '../../lib/content';

export const getStaticPaths = (async () =>
  (await getArticles()).map((article) => ({ params: { slug: article.id }, props: { article } }))) satisfies GetStaticPaths;

const { article } = Astro.props;
const { title, teaser, tag, date, minutes, spec, proposal } = article.data;
const author = await getAuthor(article.data.author);
const { Content } = await render(article);
const hasBody = !!article.body?.trim();

const relatedRefs =
  article.data.related ??
  (await getArticles()).filter((a) => a.id !== article.id).slice(0, 3).map((a) => `artikel/${a.id}`);
const related = await Promise.all(relatedRefs.map(getRelated));
---
<Base title={title} description={teaser} current="artikel">
  <main class="container page-main">
    <a href="/artikel/" class="back">← Alle Artikel</a>
    <article class="article">
      <div class="meta">
        <span class="tag tag-accent">{tag}</span>
        <span class="text-muted">{author.data.name} · {dateLong(date)} · {minutes} Min. Lesezeit</span>
      </div>
      <h1>{title}</h1>
      <Prose variant="article">
        {hasBody ? <Content /> : <p>{teaser}</p>}
      </Prose>
      {!hasBody && <p class="text-muted refs">Der vollständige Artikel ist noch in Arbeit.</p>}
      {(spec || proposal) && (
        <p class="text-muted refs">
          {spec && <>Im Standard: <a href={chapterHref(DEFAULT_EDITION, spec.chapter)}>{spec.label}</a></>}
          {spec && proposal && ' · '}
          {proposal && <>Der Vorschlag: <a href={proposal.href}>{proposal.label}</a></>}
        </p>
      )}
      {author.data.bio && <AuthorCard author={author} variant="byline" />}
    </article>

    <section class="more">
      <h6 class="kicker">Weiterlesen</h6>
      <div class="more-grid">
        {related.map((r) => <RelatedCard {...r} />)}
      </div>
    </section>
  </main>
</Base>

<style>
  .back { font-size: 14px; text-decoration: none; }
  .article { max-width: 720px; margin-top: 20px; }
  .meta { display: flex; gap: 10px; align-items: center; margin-bottom: 15px; flex-wrap: wrap; font-size: 13px; }
  h1 { font-size: clamp(34px, 6.8vw, 52px); margin-bottom: 20px; text-wrap: balance; }
  .refs { font-size: 15px; margin-top: 30px; }
  .more { margin-top: 80px; max-width: 820px; }
  .more-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 30px; }
</style>
