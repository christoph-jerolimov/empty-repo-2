---
import Base from '../../layouts/Base.astro';
import { ARTICLES, ARTICLE_TAGS } from '../../data/articles';
---
<Base title="Artikel" description="Hintergründe, Erklärstücke und Meinung zu JavaScript und dem ECMAScript-Standard." current="artikel">
  <main class="container page-main">
    <div class="page-intro">
      <h6 class="kicker">Artikel</h6>
      <h1>Längere Texte über die Sprache – und die Leute dahinter.</h1>
      <p>Hintergründe, Erklärstücke, Meinung. Alles, was länger als zehn Minuten braucht und mehr will als ein Codebeispiel.</p>
    </div>

    <div class="filters">
      <input class="input" type="search" placeholder="Artikel durchsuchen" aria-label="Artikel durchsuchen" data-article-search />
      <div class="tags" role="group" aria-label="Nach Thema filtern">
        {ARTICLE_TAGS.map((t, i) => (
          <button type="button" class="tag filter-tag" data-tag={t} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>
        ))}
      </div>
    </div>

    <div class="list">
      {ARTICLES.map((a) => (
        <a
          href={`/artikel/${a.slug}/`}
          class="es-link es-row item"
          data-article
          data-tag={a.tag}
          data-search={(a.title + a.teaser + a.author).toLowerCase()}
        >
          <div class="text-muted item-date">{a.date}<br />{a.min} Min.</div>
          <div>
            <div class="item-meta"><span class="tag tag-accent">{a.tag}</span><span class="text-muted item-author">{a.author}</span></div>
            <h3>{a.title}</h3>
            <p>{a.teaser}</p>
          </div>
        </a>
      ))}
      <p class="text-muted empty" data-empty hidden>Nichts gefunden. Vielleicht ein <a href="/tutorials/">Tutorial</a>?</p>
    </div>
  </main>
</Base>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-article-search]')!;
  const tags = [...document.querySelectorAll<HTMLButtonElement>('.filter-tag')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-article]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  let tag = 'Alle';

  function apply() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const item of items) {
      const hit = (tag === 'Alle' || item.dataset.tag === tag) && (!q || (item.dataset.search ?? '').includes(q));
      item.hidden = !hit;
      if (hit) shown++;
    }
    empty.hidden = shown > 0;
    for (const t of tags) t.setAttribute('aria-pressed', String(t.dataset.tag === tag));
  }

  search.addEventListener('input', apply);
  for (const t of tags) {
    t.addEventListener('click', () => {
      tag = t.dataset.tag ?? 'Alle';
      apply();
    });
  }
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin: 30px 0 20px; align-items: center; }
  .filters .input { max-width: 340px; }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .filter-tag {
    cursor: pointer; border: 1px solid var(--color-accent); background: transparent; color: var(--color-accent);
    font: inherit; font-size: 12px; padding: 4px 12px;
  }
  .filter-tag[aria-pressed='true'] { background: var(--color-accent); color: var(--color-bg); }

  .list { display: grid; grid-template-columns: minmax(0, 1fr); max-width: 820px; }
  .item {
    display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 20px; padding: 25px 10px;
    border-radius: var(--radius-md); margin: 0 -10px; align-items: baseline;
  }
  .item[hidden] { display: none; }
  .item-date { font-size: 13px; line-height: 1.5; }
  .item-meta { display: flex; gap: 8px; align-items: center; margin-bottom: 6px; }
  .item-author { font-size: 12px; }
  .item h3 { font-size: 26px; margin-bottom: 8px; text-wrap: balance; }
  .item p { font-size: 15px; line-height: 1.55; margin: 0; opacity: .85; }
  .empty { padding: 25px 0; }

  @media (max-width: 640px) {
    .item { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .item-date br { display: none; }
    .item h3 { font-size: 22px; }
  }
</style>
