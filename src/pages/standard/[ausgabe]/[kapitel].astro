---
import type { GetStaticPaths } from 'astro';
import StandardView from '../../../components/StandardView.astro';
import { EDITIONS, chaptersFor } from '../../../data/standard';

export const getStaticPaths = (() =>
  EDITIONS.flatMap((e) =>
    chaptersFor(e.id).map((_, i) => ({ params: { ausgabe: e.id, kapitel: String(i + 1) } })),
  )) satisfies GetStaticPaths;

const { ausgabe, kapitel } = Astro.params;
---
<StandardView editionId={ausgabe} n={Number(kapitel)} />
