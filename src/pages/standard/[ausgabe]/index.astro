---
import type { GetStaticPaths } from 'astro';
import StandardView from '../../../components/StandardView.astro';
import { EDITIONS } from '../../../data/standard';

export const getStaticPaths = (() => EDITIONS.map((e) => ({ params: { ausgabe: e.id } }))) satisfies GetStaticPaths;

const { ausgabe } = Astro.params;
---
<StandardView editionId={ausgabe} n={1} />
